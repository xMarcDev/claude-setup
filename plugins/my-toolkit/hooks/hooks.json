{
  "description": "Hooks de my-toolkit: bloquea la atribucion de Claude en commits/PR y reinyecta el contexto de trabajo (ramas, cambios, notas de tarea) al iniciar y tras compactar.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/no-claude-attribution.py\" session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/work-context.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/no-claude-attribution.py\" check",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
